#!/bin/sh /etc/rc.common
# LDownload headless server — procd service
# UCI 配置见 /etc/config/ldownload

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ldownload-server

start_service() {
	config_load ldownload

	local enabled bind data_dir
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get bind main bind "0.0.0.0:17800"
	config_get data_dir main data_dir "/etc/ldownload"

	mkdir -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		LDOWNLOAD_BIND="$bind" \
		LDOWNLOAD_DATA_DIR="$data_dir"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ldownload
}
